# --- Runtime ---
# dev | test | prod. With prod, the API refuses to start unless JWT_SECRET is a
# real secret, CORS_ORIGINS lists exact origins, and DEBUG is false.
ENVIRONMENT=dev
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1
# JSON list of allowed origins. ["*"] is dev-only; in prod list them exactly,
# e.g. ["https://admin.example.com"].
CORS_ORIGINS=["*"]

# --- Database ---
# Used when running the API outside Docker (Docker overrides it to reach `db`).
# 5433 is the port docker-compose exposes the database on.
DATABASE_URL=postgresql+asyncpg://softglow:softglow@localhost:5433/softglow
DB_ECHO=false

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-prod-please-this-is-only-for-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Media ---
# Where uploaded photos / AI results are stored (served at /media).
MEDIA_DIR=media

# --- Postgres (used by docker-compose `db` service) ---
POSTGRES_USER=softglow
POSTGRES_PASSWORD=softglow
POSTGRES_DB=softglow
